# AJSA runtime configuration. Copy to .env and fill real values. Never commit .env.
NODE_ENV=development

# PostgreSQL (private network only; not a superuser account).
DATABASE_URL=postgres://ajsa:change-me@127.0.0.1:5432/ajsa

# Docker Compose uses these to initialise the database service.
# Keep the password URL-safe because it is interpolated into DATABASE_URL.
POSTGRES_USER=ajsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ajsa

# Public origin of the dashboard. Used for cookie security and Origin checks.
APP_ORIGIN=http://localhost:3000

# 32 random bytes, base64. Encrypts provider secrets and sensitive answers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# 32+ random bytes, used to hash session tokens (HMAC). Rotate = invalidate sessions.
SESSION_SECRET=

# Private volume for CVs, evidence and export artifacts.
STORAGE_DIR=./.data/storage

# Session and privacy TTLs (proposal values from DEC-05 / DEC-08).
SESSION_TTL_HOURS=168
EXPORT_TTL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Provisional local preflight/approval window; final value awaits DEC-05.
SUBMISSION_SNAPSHOT_TTL_MINUTES=30

# Login throttle (DEC-07 proposal, configurable).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Exact HTTPS base URLs permitted for configured AI adapters.
# Add only endpoints you trust; this allowlist is separate from job-posting URLs.
AI_ALLOWED_ENDPOINT_ORIGINS=https://api.openai.com/v1,https://generativelanguage.googleapis.com/v1beta,https://api.anthropic.com/v1
