{
  "name": "ajsa",
  "version": "0.1.0",
  "private": true,
  "description": "AI Job Search Assistant (AJSA) — self-hosted single-owner job search workspace",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "provision-owner": "tsx scripts/provision-owner.ts",
    "post-restore-guard": "node --import tsx scripts/post-restore-guard.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:db": "tsx scripts/dev-postgres.ts"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@types/yazl": "2.4.6",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-x64": "true",
    "@embedded-postgres/linux-arm64": "true",
    "@embedded-postgres/darwin-x64": "true",
    "@embedded-postgres/darwin-arm64": "true"
  }
}
